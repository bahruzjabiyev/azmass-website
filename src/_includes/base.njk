<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}{% if title != settings.orgName %} — {{ settings.orgName }}{% endif %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<script defer src="/assets/js/main.js"></script>
</head>
<body>

<header class="site">
  <a class="brand" href="/">
    <img src="/assets/images/acm-logo.jpeg" alt="{{ settings.orgName }} logo">
    <span>Azerbaijani Community<br>of Massachusetts</span>
  </a>
  <button class="menu-toggle" aria-label="Toggle menu">☰</button>
  <nav>
    <a href="#about">About</a>
    <a href="#events">Events</a>
    <a href="#culture">Culture</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

{{ content | safe }}

<footer class="site">
  <div class="foot-grid">
    <div>
      <h3>{{ settings.orgName }}</h3>
      <p>{{ hero.tagline }}</p>
    </div>
    <div class="foot-links">
      <a href="#about">About Us</a>
      <a href="#events">Events</a>
      <a href="#culture">Culture</a>
      <a href="#contact">Contact</a>
    </div>
  </div>
  <p class="bottom">© {{ currentYear }} {{ settings.orgName }}. All rights reserved.</p>
</footer>

<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", (user) => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
